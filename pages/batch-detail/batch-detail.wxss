/* 清单详情：阶段进度 + 知识点掌握行（WeUI 风格） */
.bd-stages { display: flex; gap: 10px; }
.bd-stage { flex: 1; text-align: center; }
.bd-stage__bar { height: 4px; border-radius: 2px; background: var(--weui-FG-3); margin-bottom: 6px; }
.bd-stage__lb { font-size: 11px; color: var(--weui-FG-2); }
.bd-stage.is-ok .bd-stage__bar { background: var(--c-ok); }
.bd-stage.is-ok .bd-stage__lb { color: var(--c-ok); }
.bd-stage.is-warn .bd-stage__bar { background: var(--c-warn); }
.bd-stage.is-warn .bd-stage__lb { color: var(--c-warn); }

.sh-kp { margin-bottom: 10px; }
.sh-kp:last-child { margin-bottom: 0; }
.sh-kp__lb { display: flex; justify-content: space-between; font-size: 12px; color: var(--weui-FG-1); margin-bottom: 4px; }
