<view class="page">
  <view class="weui-cells__title">新建清单</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_input">
      <view class="weui-cell__hd"><view class="weui-label">清单名称</view></view>
      <view class="weui-cell__bd"><input class="weui-input" placeholder="如：第三章 二次函数 单元测验" value="{{name}}" bindinput="onName" /></view>
    </view>
    <view class="weui-cell weui-cell_input">
      <view class="weui-cell__hd"><view class="weui-label">班级</view></view>
      <view class="weui-cell__bd"><input class="weui-input" placeholder="如：初二(3)班" value="{{klass}}" bindinput="onKlass" /></view>
    </view>
    <view class="weui-cell weui-cell_input">
      <view class="weui-cell__hd"><view class="weui-label">作答日期</view></view>
      <view class="weui-cell__bd"><input class="weui-input" placeholder="如：09-08" value="{{date}}" bindinput="onDate" /></view>
    </view>
    <view class="weui-cell" style="display:block">
      <view class="bc-label">作业类型</view>
      <view class="sh-chips">
        <text class="sh-chip {{typeIdx===index ? 'sh-chip--on' : ''}}" wx:for="{{types}}" wx:key="*this" data-i="{{index}}" bindtap="pickType">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="weui-cells__title">识别范围</view>
  <view class="weui-cells">
    <view class="weui-cell" style="display:block">
      <view class="weui-cell__bd sh-caption">本题库由 AI 在录入完成后，根据清单名称与学生作答内容自动归纳本次作业实际考查的知识点，无需手动选择。</view>
    </view>
  </view>

  <view class="sh-btns">
    <button class="weui-btn weui-btn_primary" loading="{{submitting}}" bindtap="submit">创建并进入录入</button>
  </view>
</view>
